<UserControl x:Class="ApplicationStarter.Views.FileBrowserView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             PreviewKeyDown="Browser_PreviewKeyDown">
    <DockPanel Margin="8">
        <StackPanel DockPanel.Dock="Top">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Content="Laufwerke" Click="Drives_Click"/>
                <Button Grid.Column="1" Content="Nach oben" Click="Up_Click" ToolTip="Alt+Pfeil nach oben oder Ruecktaste in der Dateiliste"/>
                <TextBox Grid.Column="2" x:Name="PathInput" KeyDown="Path_KeyDown"
                         AutomationProperties.Name="Ordnerpfad" ToolTip="Strg+L oder Alt+D: Pfad bearbeiten; Eingabe: oeffnen"/>
                <Button Grid.Column="3" Content="Oeffnen" Click="Navigate_Click"/>
            </Grid>
            <WrapPanel>
                <Button Content="Aktualisieren" Click="Refresh_Click" ToolTip="F5"/>
                <Button Content="Datei anlegen" Click="NewFile_Click"/>
                <Button Content="Ordner anlegen" Click="NewFolder_Click" ToolTip="Strg+Umschalt+N"/>
                <Button Content="Umbenennen" Click="Rename_Click" ToolTip="F2 in der Dateiliste"/>
                <Button Content="Kopieren..." Click="Copy_Click"/>
                <Button Content="Verschieben..." Click="Move_Click"/>
                <Button Content="Loeschen..." Click="Delete_Click" ToolTip="Entf in der Dateiliste; immer mit Bestaetigung"/>
                <CheckBox x:Name="ShowHidden" Content="Versteckte Dateien" VerticalAlignment="Center" Margin="12,0"
                          Checked="Hidden_Changed" Unchecked="Hidden_Changed"/>
            </WrapPanel>
        </StackPanel>
        <TextBlock x:Name="Status" DockPanel.Dock="Bottom" Margin="4,8" TextWrapping="Wrap"/>
        <DataGrid x:Name="Files" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                  SelectionMode="Single" SelectionUnit="FullRow" MouseDoubleClick="Files_DoubleClick"
                  IsTabStop="True" KeyboardNavigation.TabNavigation="None" AutomationProperties.Name="Dateiliste"
                  ToolTip="Pfeiltasten: Auswahl; Eingabe: oeffnen; Ruecktaste: nach oben; F2: umbenennen; Entf: loeschen">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/>
                <DataGridCheckBoxColumn Header="Ordner" Binding="{Binding IsDirectory}" Width="65"/>
                <DataGridTextColumn Header="Bytes" Binding="{Binding Size, StringFormat=N0}" Width="100"/>
                <DataGridTextColumn Header="Geaendert" Binding="{Binding Modified, StringFormat=dd.MM.yyyy HH:mm}" Width="150"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
