<Window x:Class="ApplicationStarter.Views.ProfileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Benutzerkonten" Width="780" Height="490" MinWidth="720" MinHeight="460"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="16">
        <Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <DockPanel>
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal">
                <Button Content="Neu" Click="New_Click"/>
                <Button Content="Entfernen" Click="Delete_Click"/>
            </StackPanel>
            <ListBox x:Name="ProfilesList" DisplayMemberPath="DisplayName" SelectionChanged="Selection_Changed"/>
        </DockPanel>
        <StackPanel Grid.Column="2">
            <TextBlock Text="Lokales Benutzerkonto" FontSize="20" Margin="0,0,0,12"/>
            <TextBlock Text="Anzeigename"/>
            <TextBox x:Name="NameInput"/>
            <TextBlock Text="Lokaler Benutzername (ohne Rechnername)" Margin="0,8,0,0"/>
            <TextBox x:Name="UserInput"/>
            <TextBlock Text="Passwort" Margin="0,8,0,0"/>
            <PasswordBox x:Name="PasswordInput" Padding="5" Margin="0,3"/>
            <TextBlock Text="Leer lassen: gespeichertes Passwort beibehalten." TextWrapping="Wrap" Foreground="DimGray"/>
            <TextBlock x:Name="PasswordStatus" Margin="0,10"/>
            <StackPanel Orientation="Horizontal">
                <Button x:Name="SaveButton" Content="Konto speichern" Click="Save_Click"/>
                <Button x:Name="RemovePasswordButton" Content="Passwort entfernen" Click="RemovePassword_Click"/>
            </StackPanel>
            <TextBlock Text="Passwoerter werden mit DPAPI an Ihr Windows-Konto gebunden. Administratoren und Schadsoftware unter Ihrem Konto koennen dadurch nicht ausgeschlossen werden."
                       TextWrapping="Wrap" Foreground="DimGray" Margin="0,16,0,0"/>
            <Button Content="Schliessen" HorizontalAlignment="Right" Margin="0,16,0,0" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
