<Window x:Class="ApplicationStarter.Views.ShortcutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Verknuepfung" Width="720" Height="690" MinWidth="650" MinHeight="630"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="18">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button x:Name="SaveButton" Content="Speichern" IsDefault="True" Click="Save_Click"/>
            <Button Content="Abbrechen" IsCancel="True"/>
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Verknuepfung konfigurieren" FontSize="22" Margin="0,0,0,14"/>
                <TextBlock Text="Name"/><TextBox x:Name="NameInput"/>
                <TextBlock Text="Typ" Margin="0,8,0,0"/>
                <ComboBox x:Name="KindInput" SelectionChanged="Kind_Changed">
                    <ComboBoxItem Content="Anwendung (eigenes Fenster)"/>
                    <ComboBoxItem Content="Terminal (Tab)"/>
                    <ComboBoxItem Content="Dateibrowser (Tab)"/>
                    <ComboBoxItem Content="Ausfuehrung (Log-Tab, nicht interaktiv)"/>
                    <ComboBoxItem Content="PowerShell 5 (Skript)"/>
                    <ComboBoxItem Content="PowerShell 7 (Skript)"/>
                </ComboBox>
                <TextBlock Text="Windows-Konto" Margin="0,8,0,0"/>
                <ComboBox x:Name="ProfileInput" DisplayMemberPath="DisplayName" SelectionChanged="Profile_Changed"/>
                <CheckBox x:Name="LoadProfileInput" Content="Windows-Benutzerprofil beim Start dieser Verknuepfung laden" Margin="0,8"/>
                <TextBlock x:Name="ProfileHint" Foreground="DimGray" TextWrapping="Wrap"/>
                <StackPanel x:Name="ProgramPanel">
                    <TextBlock Text="EXE-Pfad (Umgebungsvariablen des Startkontos erlaubt)" Margin="0,12,0,0"/>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Durchsuchen..." Click="BrowseProgram_Click"/>
                        <TextBox x:Name="FileInput"/>
                    </DockPanel>
                    <TextBlock Text="Argumente" Margin="0,8,0,0"/><TextBox x:Name="ArgumentsInput"/>
                </StackPanel>
                <StackPanel x:Name="ScriptPanel" Visibility="Collapsed">
                    <TextBlock Text="Ausfuehrungsmodus" Margin="0,12,0,0"/>
                    <ComboBox x:Name="ScriptModeInput" SelectedIndex="0" AutomationProperties.Name="Skript-Ausfuehrungsmodus">
                        <ComboBoxItem Content="Nicht interaktiv (Log mit stdout/stderr und Exitcode)"/>
                        <ComboBoxItem Content="Interaktives Terminal (PowerShell bleibt geoeffnet)"/>
                    </ComboBox>
                    <CheckBox x:Name="UacInput" Content="Mit UAC" Margin="0,8"
                              ToolTip="Als Administrator im ausgewaehlten Konto starten. Erfordert ein Administratorkonto und die regulaere Windows-UAC-Bestaetigung."/>
                    <TextBlock Text="Das ausgewaehlte Konto bleibt erhalten. Nichtadministratoren und Kontowechsel im UAC-Dialog werden abgelehnt."
                               Foreground="DimGray" TextWrapping="Wrap"/>
                    <TextBlock Text="PowerShell-Skript direkt einfuegen" Margin="0,8,0,0"/>
                    <TextBox x:Name="ScriptInput" Height="220" AcceptsReturn="True" AcceptsTab="True"
                             FontFamily="Consolas" TextWrapping="NoWrap" VerticalContentAlignment="Top"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                             AutomationProperties.Name="PowerShell-Skript"
                             ToolTip="Skript hier einfuegen. Tab fuegt Einrueckung ein; Strg+Tab wechselt das Feld."/>
                    <TextBlock x:Name="InterpreterHint" Foreground="DimGray" TextWrapping="Wrap" Margin="0,6,0,0"/>
                </StackPanel>
                <TextBlock Text="Arbeitsverzeichnis / Startordner (leer = Benutzerverzeichnis)" Margin="0,8,0,0"/>
                <TextBox x:Name="DirectoryInput"/>
                <TextBlock Text="Eigenes Icon (ICO- oder EXE-Datei; leer = Ziel-Icon)" Margin="0,8,0,0"/>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Durchsuchen..." Click="BrowseIcon_Click"/>
                    <TextBox x:Name="IconInput"/>
                </DockPanel>
                <TextBlock Text="Icon-Pfade werden unter Ihrem aktuellen Windows-Konto gelesen. Programmpfade und Arbeitsverzeichnis werden dagegen unter dem ausgewaehlten Startkonto aufgeloest."
                           Foreground="DimGray" TextWrapping="Wrap" Margin="0,12,0,0"/>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
