<Window x:Class="SqlTransfer.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:inf="clr-namespace:SqlTransfer.Infrastructure"
        xmlns:vm="clr-namespace:SqlTransfer.ViewModels"
        Icon="pack://application:,,,/Assets/app.ico"
        Width="1000" Height="840" MinWidth="880" MinHeight="700"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="B2V" />
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Kopfzeile -->
        <DockPanel Grid.Row="0" Margin="0,0,0,12" LastChildFill="False">
            <Button DockPanel.Dock="Left" Content="{inf:T App_Servers}" Click="ManageServers_Click"
                    IsEnabled="{Binding IsIdle}" />
            <ComboBox DockPanel.Dock="Right" Width="110"
                      ItemsSource="{x:Static inf:Loc.Languages}" DisplayMemberPath="Name" SelectedValuePath="Code"
                      SelectedValue="{Binding Language, Source={x:Static inf:Loc.Instance}, Mode=TwoWay}" />
            <TextBlock DockPanel.Dock="Right" Text="{inf:T App_Language}" Style="{StaticResource Muted}"
                       VerticalAlignment="Center" Margin="0,0,8,0" />
        </DockPanel>

        <!-- Quelle / Ziel -->
        <Grid Grid.Row="1" IsEnabled="{Binding IsIdle}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="{inf:T Src_Header}" Style="{StaticResource CardHeader}" />
                    <RadioButton Content="{inf:T Mode_New}" IsChecked="{Binding IsNewBackupMode}" GroupName="SourceMode" Margin="0,0,0,4" />
                    <RadioButton Content="{inf:T Mode_Existing}" IsChecked="{Binding IsExistingBackupMode}" GroupName="SourceMode" />

                    <StackPanel Margin="0,8,0,0" Visibility="{Binding IsNewBackupMode, Converter={StaticResource B2V}}">
                        <TextBlock Text="{inf:T Server}" Style="{StaticResource FieldLabel}" Margin="0,0,0,3" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox ItemsSource="{Binding Servers}" DisplayMemberPath="DisplayName"
                                      SelectedItem="{Binding SourceServer}" />
                            <Button Grid.Column="1" Margin="6,0,0,0" Content="{inf:T Test}" Command="{Binding TestSourceCommand}" />
                        </Grid>
                        <TextBlock Text="{Binding SourceInfo}" Style="{StaticResource Muted}" Margin="0,6,0,0" />
                        <TextBlock Text="{inf:T Database}" Style="{StaticResource FieldLabel}" />
                        <ComboBox ItemsSource="{Binding SourceDatabases}" SelectedItem="{Binding SelectedSourceDb}"
                                  DropDownOpened="SourceDatabases_DropDownOpened" />
                        <TextBlock Text="{inf:T Loading}" Style="{StaticResource Muted}" Margin="0,4,0,0"
                                   Visibility="{Binding IsLoadingDatabases, Converter={StaticResource B2V}}" />
                    </StackPanel>

                    <StackPanel Margin="0,8,0,0" Visibility="{Binding IsExistingBackupMode, Converter={StaticResource B2V}}">
                        <TextBlock Text="{inf:T BackupFile}" Style="{StaticResource FieldLabel}" Margin="0,0,0,3" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding BackupFile}" />
                            <Button Grid.Column="1" Margin="6,0,0,0" Content="{inf:T Browse}" Click="BrowseBackup_Click" />
                        </Grid>
                        <TextBlock Text="{inf:T BackupFileHint}" Style="{StaticResource Muted}" Margin="0,6,0,0" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Button Grid.Column="1" Content="⇄" FontSize="20" Margin="10,0" Padding="8,2" VerticalAlignment="Center"
                    ToolTip="{inf:T Swap}" Command="{Binding SwapCommand}"
                    Visibility="{Binding IsNewBackupMode, Converter={StaticResource B2V}}" />

            <Border Grid.Column="2" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="{inf:T Dst_Header}" Style="{StaticResource CardHeader}" />
                    <TextBlock Text="{inf:T Server}" Style="{StaticResource FieldLabel}" Margin="0,0,0,3" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ComboBox ItemsSource="{Binding Servers}" DisplayMemberPath="DisplayName"
                                  SelectedItem="{Binding TargetServer}" />
                        <Button Grid.Column="1" Margin="6,0,0,0" Content="{inf:T Test}" Command="{Binding TestTargetCommand}" />
                    </Grid>
                    <TextBlock Text="{Binding TargetInfo}" Style="{StaticResource Muted}" Margin="0,6,0,0" />
                    <TextBlock Text="{inf:T TargetDb}" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding TargetDb, UpdateSourceTrigger=PropertyChanged}" />
                    <CheckBox Content="{inf:T Overwrite}" IsChecked="{Binding Overwrite}" Margin="0,10,0,0" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Optionen und Start/Abbruch -->
        <DockPanel Grid.Row="2" Margin="0,12">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="{inf:T Cancel}" Command="{Binding CancelCommand}" Margin="0,0,8,0" Padding="20,7" />
                <Button Content="{inf:T Start}" Command="{Binding StartCommand}" Style="{StaticResource PrimaryButton}" />
            </StackPanel>
            <StackPanel VerticalAlignment="Center" IsEnabled="{Binding IsIdle}">
                <CheckBox Content="{inf:T DeleteSource}" IsChecked="{Binding DeleteSourceBackup}" Margin="0,0,0,4"
                          Visibility="{Binding IsNewBackupMode, Converter={StaticResource B2V}}" />
                <CheckBox Content="{inf:T DeleteTarget}" IsChecked="{Binding DeleteTargetBackup}" />
            </StackPanel>
        </DockPanel>

        <!-- Ablauf -->
        <Border Grid.Row="3" Style="{StaticResource Card}">
            <StackPanel>
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <TextBlock Text="{inf:T TotalTime}" Style="{StaticResource Muted}" Margin="0,0,6,0" />
                        <TextBlock Text="{Binding TotalElapsed}" FontWeight="SemiBold" MinWidth="50" />
                    </StackPanel>
                    <TextBlock Text="{inf:T Progress}" Style="{StaticResource CardHeader}" />
                </DockPanel>
                <ItemsControl ItemsSource="{Binding StepList}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:StepViewModel}">
                            <Grid Margin="0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="32" />
                                    <ColumnDefinition Width="220" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="70" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="Glyph" Text="{Binding Glyph}" FontFamily="Segoe UI Symbol" FontSize="18"
                                           Foreground="{StaticResource MutedBrush}" VerticalAlignment="Top" />
                                <TextBlock Grid.Column="1" Text="{Binding Title}" FontWeight="SemiBold" VerticalAlignment="Top" Margin="0,2,0,0" />
                                <StackPanel Grid.Column="2" Margin="0,5,12,0">
                                    <ProgressBar x:Name="Bar" Height="8" Minimum="0" Maximum="100"
                                                 Value="{Binding Progress, Mode=OneWay}"
                                                 IsIndeterminate="{Binding IsIndeterminate, Mode=OneWay}" />
                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource Muted}" Margin="0,3,0,0" />
                                </StackPanel>
                                <TextBlock Grid.Column="3" Text="{Binding Elapsed}" HorizontalAlignment="Right"
                                           Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0" />
                            </Grid>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Status}" Value="Running">
                                    <Setter TargetName="Glyph" Property="Foreground" Value="{StaticResource AccentBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Status}" Value="Done">
                                    <Setter TargetName="Glyph" Property="Foreground" Value="{StaticResource OkBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Status}" Value="Warning">
                                    <Setter TargetName="Glyph" Property="Foreground" Value="{StaticResource WarnBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Status}" Value="Canceled">
                                    <Setter TargetName="Glyph" Property="Foreground" Value="{StaticResource WarnBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Status}" Value="Failed">
                                    <Setter TargetName="Glyph" Property="Foreground" Value="{StaticResource ErrorBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Status}" Value="Pending">
                                    <Setter TargetName="Bar" Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Status}" Value="Skipped">
                                    <Setter TargetName="Bar" Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- Ergebnis -->
        <Border Grid.Row="4" Margin="0,12,0,0" Padding="12,8" CornerRadius="6">
            <TextBlock Text="{Binding ResultText}" TextWrapping="Wrap" FontWeight="SemiBold" Foreground="White" />
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ResultState}" Value="Success">
                            <Setter Property="Visibility" Value="Visible" />
                            <Setter Property="Background" Value="{StaticResource OkBrush}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding ResultState}" Value="Failed">
                            <Setter Property="Visibility" Value="Visible" />
                            <Setter Property="Background" Value="{StaticResource ErrorBrush}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding ResultState}" Value="Canceled">
                            <Setter Property="Visibility" Value="Visible" />
                            <Setter Property="Background" Value="{StaticResource WarnBrush}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
        </Border>

        <!-- Protokoll -->
        <Border Grid.Row="5" Style="{StaticResource Card}" Margin="0,12,0,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="{inf:T Log}" Style="{StaticResource CardHeader}" />
                <TextBox x:Name="LogBox" Text="{Binding LogText, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12" BorderThickness="0"
                         Background="#F8FAFC" TextChanged="LogBox_TextChanged" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
