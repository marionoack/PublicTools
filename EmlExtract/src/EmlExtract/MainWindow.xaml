<Window x:Class="EmlExtract.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:EmlExtract"
        xmlns:vm="clr-namespace:EmlExtract.ViewModels"
        mc:Ignorable="d"
        Title="EML Extract" Height="650" Width="950"
        Icon="Assets/EmlExtract.ico"
        AllowDrop="True"
        Drop="Window_Drop"
        DragOver="Window_DragOver">
    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Top bar: file picker + drag&drop zone -->
        <Border Grid.Row="0" BorderBrush="Gray" BorderThickness="2"
                CornerRadius="4" Padding="15" Margin="0,0,0,10"
                Background="#FFF5F5F5" MinHeight="70">
            <DockPanel LastChildFill="True">
                <Button DockPanel.Dock="Right" Content="E-Mail-Datei wählen..."
                        Command="{Binding BrowseFileCommand}"
                        Padding="10,5" VerticalAlignment="Center" />
                <TextBlock VerticalAlignment="Center"
                           Text="Ziehen Sie eine .eml- oder .msg-Datei hierher oder wählen Sie eine Datei aus."
                           FontStyle="Italic" Foreground="#FF555555" />
            </DockPanel>
        </Border>

        <!-- Main content: header/body preview + attachments -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <GroupBox Grid.Column="0" Header="Inhalt">
                <Grid Margin="5">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" Margin="0,0,0,5" LastChildFill="True">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                            <Button Content="Copy (HTML)" Command="{Binding CopyHtmlCommand}" Padding="6,2" Margin="0,0,5,0" />
                            <Button Content="Copy (MD)" Command="{Binding CopyMarkdownCommand}" Padding="6,2" Margin="0,0,5,0" />
                            <Button Content="Copy (TXT)" Command="{Binding CopyTextCommand}" Padding="6,2" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="{Binding CurrentDocument.Subject, StringFormat='Betreff: {0}'}" FontWeight="Bold" />
                            <TextBlock Text="{Binding CurrentDocument.From, StringFormat='Von: {0}'}" />
                            <TextBlock Text="{Binding CurrentDocument.To, StringFormat='An: {0}'}" />
                            <TextBlock Text="{Binding CurrentDocument.Date, StringFormat='Datum: {0}'}" />
                        </StackPanel>
                    </DockPanel>
                    <WebBrowser Grid.Row="1" x:Name="BodyPreview" />
                </Grid>
            </GroupBox>

            <GroupBox Grid.Column="2" Header="Anhänge">
                <ListBox ItemsSource="{Binding Attachments}" Margin="5">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Center" Margin="0,0,5,0" />
                                <TextBlock Text="{Binding FileName}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding SizeDisplay, StringFormat=' ({0})'}" Foreground="Gray" VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </GroupBox>
        </Grid>

        <!-- Export options -->
        <GroupBox Grid.Row="2" Header="Export-Optionen" Margin="0,10,0,10">
            <StackPanel Margin="5">
                <WrapPanel>
                    <CheckBox Content="Attachments exportieren" IsChecked="{Binding ExportAttachments}" Margin="0,0,20,0" />
                    <CheckBox Content="Inhalt + Header als HTML" IsChecked="{Binding ExportHtml}" Margin="0,0,20,0" />
                    <CheckBox Content="Zusätzlich als Markdown" IsChecked="{Binding ExportMarkdown}" Margin="0,0,20,0" />
                    <CheckBox Content="Footer entfernen (optional)" IsChecked="{Binding RemoveFooter}" />
                </WrapPanel>
                <DockPanel Margin="0,10,0,0">
                    <Button DockPanel.Dock="Right" Content="Zielordner..." Command="{Binding BrowseOutputFolderCommand}" Padding="8,3" />
                    <TextBlock Text="Zielordner:" VerticalAlignment="Center" Margin="0,0,5,0" />
                    <TextBox Text="{Binding OutputFolder, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Margin="0,0,10,0" />
                </DockPanel>
            </StackPanel>
        </GroupBox>

        <!-- Export button + status -->
        <DockPanel Grid.Row="3">
            <Button DockPanel.Dock="Right" Content="Exportieren" Command="{Binding ExportCommand}" Padding="15,5" FontWeight="Bold" />
            <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" />
        </DockPanel>
    </Grid>
</Window>
